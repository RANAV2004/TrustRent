ENVIRONMENT=development
DEBUG=True
CORS_ORIGINS=["http://localhost:3000"]
JWT_SECRET=change-this-to-a-long-random-secret-min-32-chars
DATABASE_URL=sqlite+aiosqlite:///./trustrent.db
DEMO_MODE=True
SEED_SAMPLE_LISTINGS=True
ADMIN_EMAILS=["admin@trustrent.in"]
DEMO_ADMIN_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=trustrent.otp@gmail.com
SMTP_APP_PASSWORD=
SMTP_FROM_NAME=TrustRent
SMTP_FROM_EMAIL=
GOOGLE_CLIENT_ID=
# Website address used in emails (lawyer sign-in details), e.g. https://trustrent.in
APP_URL=
# Admins sign in with a password plus an authenticator-app code ("required" or "optional")
ADMIN_TWO_FACTOR=required
# Email users about new messages, visits, deposits and decisions (True/False)
EMAIL_NOTIFICATIONS=True
# Error alerts: emailed to ADMIN_EMAILS unless ERROR_ALERT_EMAILS is set; SENTRY_DSN is optional
ERROR_ALERTS=True
ERROR_ALERT_EMAILS=[]
SENTRY_DSN=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./local_storage
# Demo key only. The server refuses to start with it when DEMO_MODE=False: generate your own with
# python -c "import secrets; print(secrets.token_hex(32))"
STORAGE_MASTER_KEY_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PRIVATE_BUCKET=
S3_PUBLIC_BUCKET=
MEDIA_PUBLIC_BASE_URL=
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
CHAIN_ID=80002
DEPLOYER_PRIVATE_KEY=
DEPOSIT_REGISTRY_ADDRESS=
CHAIN_SIGNER_PRIVATE_KEY=
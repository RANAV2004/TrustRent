ENVIRONMENT=development
DEBUG=True
CORS_ORIGINS=["http://localhost:3000"]
# Production (ENVIRONMENT=production) refuses to start with DEMO_MODE on, a weak JWT_SECRET or a missing/sample storage key.
JWT_SECRET=change-this-to-a-long-random-secret-min-32-chars
DATABASE_URL=sqlite+aiosqlite:///./trustrent.db
# Demo shortcuts: Google sign-in by email, auto-approved IDs, fake payments. Local development only.
DEMO_MODE=True
# Old wallet/tenancy/evidence API. Off unless you need it.
ENABLE_LEGACY_API=False
SEED_SAMPLE_LISTINGS=True
ADMIN_EMAILS=["admin@trustrent.in"]
DEMO_ADMIN_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=trustrent.otp@gmail.com
SMTP_APP_PASSWORD=
SMTP_FROM_NAME=TrustRent
SMTP_FROM_EMAIL=
GOOGLE_CLIENT_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard > Webhooks: URL https://<api>/api/v1/payments/webhook, events payment.captured and order.paid
RAZORPAY_WEBHOOK_SECRET=
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./local_storage
# 64 hex characters (32 random bytes). Generate: python -c "import secrets;print(secrets.token_hex(32))"
# Empty in development = a public sample key with a warning. Production refuses to start without a real one.
STORAGE_MASTER_KEY_HEX=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PRIVATE_BUCKET=
S3_PUBLIC_BUCKET=
MEDIA_PUBLIC_BASE_URL=
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
CHAIN_ID=80002
DEPLOYER_PRIVATE_KEY=
DEPOSIT_REGISTRY_ADDRESS=
CHAIN_SIGNER_PRIVATE_KEY=
# Links in emails (password reset, notifications) point here
FRONTEND_URL=http://localhost:3000
# Admins and arbitrators must use an authenticator app (TOTP) after their password
REQUIRE_STAFF_MFA=True
# Deposit deadlines: tenant must answer a proposal within N days, owner must propose within M days of move-out
SETTLEMENT_RESPONSE_DAYS=7
MOVE_OUT_CLAIM_DAYS=14
# Background jobs (deadlines, blockchain copies, saved-search alerts) run every N seconds in the API process
RUN_BACKGROUND_JOBS=True
JOB_INTERVAL_SECONDS=600
RATE_LIMIT_ENABLED=True
MAX_REQUEST_MB=50
# Operations: JSON logs for log collectors, and optional Sentry error tracking
LOG_JSON=False
SENTRY_DSN=
